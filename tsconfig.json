{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"module": "CommonJS",
		"moduleResolution": "node",
		"rootDir": "./src",
		"outDir": "dist",
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true,
		"declaration": false
	},
	"include": ["src"]
}
